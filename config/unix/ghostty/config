# Release Control+Command+Arrows so Rectangle's window-snap shortcuts work in Ghostty.
# (Ghostty's defaults bind these to resize_split; Rectangle's alternate set uses them for halves.)
keybind = super+ctrl+left=unbind
keybind = super+ctrl+right=unbind
keybind = super+ctrl+up=unbind
keybind = super+ctrl+down=unbind
