{
  "$comment": "Global (user-scope) MCP servers used by Roman. Applied to a new machine via install-mcp.sh. Keep this in sync with `claude mcp list`. Servers that need secrets read them from the environment at runtime (see README) — never hardcode tokens here.",
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "XcodeBuildMCP": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest", "mcp"],
      "env": {}
    },
    "firebase": {
      "type": "stdio",
      "command": "firebase",
      "args": ["mcp"],
      "env": {}
    },
    "plantuml": {
      "type": "stdio",
      "command": "npx",
      "args": ["plantuml-mcp-server"],
      "env": {
        "PLANTUML_SERVER_URL": "https://www.plantuml.com/plantuml"
      }
    },
    "frame0-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "frame0-mcp-server"],
      "env": {}
    },
    "roadmapsh": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-roadmapsh@0.2.0"],
      "env": {}
    },
    "office-word": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "office-word-mcp-server", "word_mcp_server"],
      "env": {}
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "nerdz": {
      "type": "http",
      "url": "https://mcp.nerdz.team/mcp"
    }
  }
}
